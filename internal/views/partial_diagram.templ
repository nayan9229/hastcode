package views

// Diagram is a Mermaid diagram as an inline-SVG figure, captioned from the
// fence's title line. Styled by the .diagram rules in site.css.
templ Diagram(d DiagramFigure) {
	<figure class="diagram" data-pagefind-ignore>
		@templ.Raw(d.SVG)
		if d.Caption != "" {
			<figcaption>{ d.Caption }</figcaption>
		}
	</figure>
}
