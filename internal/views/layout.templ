package views

// Layout is the shell of every page. Page body goes in children.
templ Layout(p Page) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@Head(p)
		</head>
		<body>
			<a class="skip-link" href="#main">Skip to content</a>
			@SiteHeader(p.Chrome)
			<main id="main" class="wrap">
				{ children... }
			</main>
			@SiteFooter(p.Chrome)
		</body>
	</html>
}
