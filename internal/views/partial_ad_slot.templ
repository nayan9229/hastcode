package views

// Ad slot positions in the Explainer and Brief layouts.
const (
	AdAfterTLDR = "after-tldr"
	AdAfterBody = "after-body"
)

// adsenseLoader emits the AdSense library once per page, at the first slot,
// so pages without slots never load it.
var adsenseLoader = templ.NewOnceHandle()

// AdSlot is the single ad component (spec "Analytics, ads, consent"). Its
// box has a fixed height (.ad-slot in site.css) in both states, so turning
// ads on causes no layout shift. With ads off it is an empty, aria-hidden
// placeholder; with ads on it holds one AdSense unit. Pagefind never
// indexes it.
templ AdSlot(ads Ads, position string) {
	if ads.Enabled {
		<aside class="ad-slot" aria-label="Advertisement" data-ad-position={ position } data-pagefind-ignore="all">
			@adsenseLoader.Once() {
				<script async src={ "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + ads.Client } crossorigin="anonymous"></script>
			}
			<ins class="adsbygoogle" data-ad-client={ ads.Client }></ins>
			@templ.Raw("<script>(adsbygoogle=window.adsbygoogle||[]).push({});</script>")
		</aside>
	} else {
		<aside class="ad-slot" aria-hidden="true" data-ad-position={ position } data-pagefind-ignore="all"></aside>
	}
}
