package views

// Ad slot positions (data-ad-position) in the Explainer and Brief layouts.
const (
	AdAfterTLDR         = "after-tldr"          // Explainer: after the TL;DR
	AdAfterWhatHappened = "after-what-happened" // Brief: after "What happened"
	AdAfterBody         = "after-body"          // both: after the article body
)

// adsenseLoader emits the AdSense library once per page, at the first slot,
// so pages without slots never load it.
var adsenseLoader = templ.NewOnceHandle()

// AdSlot is the single ad component (spec "Analytics, ads, consent"),
// controlled by one flag. With ads off it renders nothing and reserves no
// space: v1 pages carry no blank boxes. With ads on it is one AdSense unit
// in a box whose height is fixed (.ad-slot in site.css), so the unit
// filling in causes no layout shift. Pagefind never indexes it.
templ AdSlot(ads Ads, position string) {
	if ads.Enabled {
		<aside class="ad-slot" aria-label="Advertisement" data-ad-position={ position } data-pagefind-ignore="all">
			@adsenseLoader.Once() {
				<script async src={ "https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=" + ads.Client } crossorigin="anonymous"></script>
			}
			<ins class="adsbygoogle" data-ad-client={ ads.Client }></ins>
			@templ.Raw("<script>(adsbygoogle=window.adsbygoogle||[]).push({});</script>")
		</aside>
	}
}
