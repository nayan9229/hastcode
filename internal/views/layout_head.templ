package views

// Head is the <head> every page carries: charset, viewport, title,
// description, robots (max-image-preview:large for Discover, or noindex),
// canonical, Open Graph/Twitter card, both theme-colors, the inline theme
// script (before the stylesheet so a stored override applies before first
// paint), the inline stylesheet (ADR-0006), the SVG mark as an embedded favicon, the hero preload
// on article pages, JSON-LD and (when configured) analytics.
templ Head(p Page) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ p.Title }</title>
	<meta name="description" content={ p.Description }/>
	if p.NoIndex {
		<meta name="robots" content="noindex"/>
	} else {
		<meta name="robots" content="max-image-preview:large"/>
	}
	if p.Canonical != "" {
		<link rel="canonical" href={ p.Canonical }/>
	}
	@SocialMeta(p)
	<meta name="color-scheme" content="light dark"/>
	<meta name="theme-color" media="(prefers-color-scheme: light)" content={ lightPalette.bg }/>
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content={ darkPalette.bg }/>
	@templ.Raw("<script>" + themeScript + "</script>")
	@templ.Raw(string(inlineStyle))
	<link rel="icon" type="image/svg+xml" href={ templ.SafeURL(markDataURI) }/>
	if p.HeroPreload != nil {
		@HeroPreloadLink(*p.HeroPreload)
	}
	@StructuredData(p.StructuredData)
	@AnalyticsScripts(p.Analytics)
}
