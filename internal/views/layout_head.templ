package views

// Head is the <head> every page carries: charset, viewport, title,
// description, both theme-colors, the inline theme script (before the
// stylesheet so a stored override applies before first paint), the hashed
// stylesheet and the SVG mark as favicon.
templ Head(p Page) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<title>{ p.Title }</title>
	<meta name="description" content={ p.Description }/>
	if p.NoIndex {
		<meta name="robots" content="noindex"/>
	}
	<meta name="color-scheme" content="light dark"/>
	<meta name="theme-color" media="(prefers-color-scheme: light)" content={ lightPalette.bg }/>
	<meta name="theme-color" media="(prefers-color-scheme: dark)" content={ darkPalette.bg }/>
	@templ.Raw("<script>" + themeScript + "</script>")
	<link rel="stylesheet" href={ stylesheetPath }/>
	<link rel="icon" type="image/svg+xml" href={ MarkPath }/>
}
