package views

// AnalyticsScripts is Google Analytics 4 (ADR-0008): a small inline
// snippet, then gtag.js deferred so it never runs before the page has
// parsed. Omitted entirely when no Measurement ID is configured (preview
// builds).
templ AnalyticsScripts(a Analytics) {
	if a.MeasurementID != "" {
		@templ.Raw("<script>" + analyticsSnippet(a) + "</script>")
		<script defer src={ gtagURL(a.MeasurementID) }></script>
	}
}
