package views

// HeroPicture is the hero figure: AVIF and WebP sources with a JPEG <img>
// fallback. width/height reserve layout space (no CLS); the hero is the LCP
// element, so it loads eagerly at high priority.
templ HeroPicture(h Hero) {
	<figure class="hero">
		<picture>
			<source type="image/avif" srcset={ Srcset(h.AVIF) } sizes={ h.Sizes }/>
			<source type="image/webp" srcset={ Srcset(h.WebP) } sizes={ h.Sizes }/>
			<img
				src={ h.Img.URL }
				srcset={ Srcset(h.JPEG) }
				sizes={ h.Sizes }
				width={ h.Img.Width }
				height={ h.Img.Height }
				alt={ h.Alt }
				fetchpriority="high"
				decoding="async"
			/>
		</picture>
	</figure>
}

// HeroPreloadLink goes in <head>: browsers that support AVIF start fetching
// the right hero width before parsing the body; others skip it by type.
templ HeroPreloadLink(h Hero) {
	<link rel="preload" as="image" type="image/avif" imagesrcset={ Srcset(h.AVIF) } imagesizes={ h.Sizes } fetchpriority="high"/>
}
