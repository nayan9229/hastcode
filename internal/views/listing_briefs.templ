package views

// BriefsIndex is one page of the Briefs index. Items come from PieceList
// (h-entry with p-name, u-url, p-summary, dt-published).
templ BriefsIndex(p BriefsIndexPage) {
	@Layout(p.Page) {
		<section class="listing">
			<h1>{ p.Heading }</h1>
			if len(p.Items) == 0 {
				<p class="muted">No Briefs yet.</p>
			} else {
				@PieceList("brief-list", p.Items, 2)
			}
			@PaginationNav(p.Pagination)
		</section>
	}
}
